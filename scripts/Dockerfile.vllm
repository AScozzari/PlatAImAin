# ─── vLLM Worker — LLM/Coding/Vision/Embedding ────────────────────────────────
# Raccomandato solo per modelli ≤7B (≤5GB pesi).
# Per modelli 32B/72B usa l'immagine base vllm/vllm-openai + RunPod Network Volume.
#
# Build:
#   docker build -f scripts/Dockerfile.vllm \
#     --build-arg HF_REPO=Qwen/Qwen2.5-7B-Instruct \
#     --build-arg HF_TOKEN=hf_xxx \
#     -t plataimain/vllm-qwen7b:latest .
#
# Per modelli vision (VL):
#   --build-arg HF_REPO=Qwen/Qwen2.5-VL-7B-Instruct
#   --build-arg EXTRA_ARGS="--limit-mm-per-prompt image=5"
#
# Per embedding:
#   --build-arg HF_REPO=BAAI/bge-m3
#   --build-arg EXTRA_ARGS="--task embedding"
# ─────────────────────────────────────────────────────────────────────────────

FROM vllm/vllm-openai:latest AS downloader

ARG HF_REPO=Qwen/Qwen2.5-7B-Instruct
ARG HF_TOKEN

RUN pip install --no-cache-dir huggingface_hub[hf_transfer]

RUN python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download( \
    '${HF_REPO}', \
    local_dir='/models/${HF_REPO}', \
    token='${HF_TOKEN}', \
    ignore_patterns=['*.pt'] \
)"

# ─── Runtime stage ────────────────────────────────────────────────────────────
FROM vllm/vllm-openai:latest

ARG HF_REPO=Qwen/Qwen2.5-7B-Instruct
ARG EXTRA_ARGS=""

# Copy baked weights
COPY --from=downloader /models /models

ENV MODEL_PATH=/models/${HF_REPO}

EXPOSE 8000
CMD ["python", "-m", "vllm.entrypoints.openai.api_server", \
     "--model", "/models/${HF_REPO}", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--served-model-name", "${HF_REPO}"]
