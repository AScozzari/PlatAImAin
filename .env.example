# ============================================================
# Custom AI Gateway — Environment Variables
# Copy to .env and fill in all values before running
# ============================================================

# App
DEBUG=false
PORT=8000

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://customai:customai@postgres:5432/customai

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── vLLM backend URLs (internal Docker network) ────────────
VLLM_LLM_URL=http://vllm-llm:8001
VLLM_VISION_URL=http://vllm-vision:8002
VLLM_CODING_URL=http://vllm-coding:8003
VLLM_EMBEDDING_URL=http://vllm-embedding:8004

# ─── Models config ──────────────────────────────────────────
MODELS_CONFIG_PATH=models.config.json

# ─── JWT Auth ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
SESSION_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_SESSIONS_PER_USER=5

# ─── OAuth2 Google ──────────────────────────────────────────
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/oauth2/google/callback

# ─── OAuth2 GitHub ──────────────────────────────────────────
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_GITHUB_REDIRECT_URI=https://yourdomain.com/auth/oauth2/github/callback

# Dashboard URL (for OAuth2 redirect after login)
DASHBOARD_URL=http://localhost:3000

# ─── Type B Models — STT ────────────────────────────────────
STT_ENABLED=true
WHISPER_MODEL_PATH=/models/stt/whisper-large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ─── Type B Models — TTS ────────────────────────────────────
TTS_XTTS_ENABLED=true
XTTS_MODEL_PATH=/models/tts/xtts-v2

TTS_KOKORO_ENABLED=true
KOKORO_MODEL_PATH=/models/tts/kokoro-v1

TTS_STYLETT2_ENABLED=false
STYLETT2_MODEL_PATH=/models/tts/stylett2

# Voice storage path (for cloned voices)
VOICES_STORAGE_PATH=/data/voices

# ─── Langfuse Tracing ───────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3001

# ─── Rate Limits (requests per minute per plan) ─────────────
RATE_LIMIT_STARTER=60
RATE_LIMIT_BUSINESS=300
RATE_LIMIT_ENTERPRISE=1000

# ─── Fallback Provider (optional) ───────────────────────────
FALLBACK_ENABLED=false
FALLBACK_OPENAI_KEY=

# ─── Admin ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# ─── PostgreSQL (used by docker-compose) ────────────────────
POSTGRES_DB=customai
POSTGRES_USER=customai
POSTGRES_PASSWORD=customai

# ─── Grafana (used by docker-compose) ───────────────────────
GRAFANA_ADMIN_PASSWORD=admin
